# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Environment and secret files (never commit)
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example

# Local machine configuration
/android/local.properties
/android/key.properties
/android/*.jks
/android/*.keystore
/android/*.p12
/android/*.pfx
/android/app/*.jks
/android/app/*.keystore

