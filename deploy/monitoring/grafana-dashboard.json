      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "title": "Worker Processed Batches / sec",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(frs_worker_batches_processed_total[1m])",
          "legendFormat": "Processed Batches / sec",
          "refId": "A"
        }
