# Copy to backend/.env and replace every placeholder before starting.
FRS_ENV=development
FRS_DATABASE_URL=postgresql+psycopg://frs:CHANGE_ME@db:5432/frs

# Generate secrets; never commit the populated .env file.
FRS_DEVICE_API_KEYS=REPLACE_WITH_RANDOM_DEVICE_KEY_AT_LEAST_32_CHARS
FRS_ADMIN_API_KEY=REPLACE_WITH_DIFFERENT_RANDOM_ADMIN_KEY_AT_LEAST_32_CHARS
FRS_DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES

# Primary real inference pack. InsightFace source code is MIT-licensed, but
# its published pretrained model weights are restricted to non-commercial
# research unless separately licensed. Verify the exact artifact license.
FRS_MODEL_PACK=buffalo_l
FRS_MODEL_ROOT=/models/insightface
FRS_DETECT_SIZE=640
FRS_MODEL_PROVIDER=CPUExecutionProvider

# Set paths only to real, compatible ONNX artifacts with documented licenses.
FRS_RETINAFACE_ONNX_PATH=
FRS_ADAFACE_ONNX_PATH=
FRS_MOBILEFACENET_ONNX_PATH=
FRS_MINIFASNET_ONNX_PATH=

# Security and decision policy. Do not enable production attendance until
# local data calibration and required security-model evaluation are complete.
FRS_REQUIRE_LIVENESS=true
FRS_MINIMUM_IDENTIFICATION_FRAMES=3
FRS_MAXIMUM_IDENTIFICATION_FRAMES=8
FRS_ATTENDANCE_COOLDOWN_SECONDS=60
FRS_SIMILARITY_THRESHOLD=0.50
FRS_THRESHOLD_CALIBRATED=false
FRS_REQUIRED_LIVENESS_SCORE=0.90

FRS_MIN_FACE_SIZE_PX=80
FRS_MIN_LAPLACIAN_VARIANCE=25.0
FRS_MIN_MEAN_LUMINANCE=35.0
FRS_MAX_MEAN_LUMINANCE=220.0
FRS_MAX_CLIPPED_PIXEL_RATIO=0.40
FRS_AMBIGUITY_MARGIN=0.05
FRS_RECOGNITION_TOP_K=5
FRS_MAX_UPLOAD_BYTES=5242880
FRS_MAX_REQUEST_BYTES=41943040
FRS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
