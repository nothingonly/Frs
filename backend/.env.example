# Copy to .env, generate fresh secrets, and replace every placeholder.
FRS_ENV=development
POSTGRES_DB=frs
POSTGRES_USER=frs
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
FRS_DATABASE_URL=postgresql+psycopg://frs:REPLACE_WITH_RANDOM_POSTGRES_PASSWORD@db:5432/frs
FRS_BIND_ADDRESS=127.0.0.1
FRS_BIND_PORT=8000

FRS_DEVICE_API_KEYS=REPLACE_WITH_RANDOM_DEVICE_KEY_AT_LEAST_32_CHARS
# JSON map: lowercase SHA-256 of each exact kiosk token -> allowed class_group_id list.
# Missing fingerprints grant no attendance-session access.
FRS_DEVICE_CLASS_GROUP_SCOPES_JSON={}
# Dedicated Ed25519 certificate-signing seed: URL-safe base64 for exactly 32 random bytes.
# Never reuse JWT, admin, device or data-encryption material.
FRS_DELETION_CERTIFICATE_KEY=REPLACE_WITH_BASE64_URLSAFE_32_BYTE_ED25519_SEED
FRS_ADMIN_API_KEY=REPLACE_WITH_DIFFERENT_RANDOM_ADMIN_KEY_AT_LEAST_32_CHARS
FRS_JWT_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS
FRS_DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_URLSAFE_32_RANDOM_BYTES

FRS_MODEL_PACK=buffalo_l
FRS_MODEL_ROOT=/models/insightface
FRS_DETECT_SIZE=640
FRS_MODEL_PROVIDER=CPUExecutionProvider
# Deprecated informational flag only; it cannot override restrictive model license terms.
FRS_MODEL_LICENSE_ATTESTED=false
# Production LTI 1.3 requires the actual trusted LMS public key and identifiers.
FRS_LTI_CLIENT_ID=
FRS_LTI_ISSUER=
FRS_LTI_DEPLOYMENT_ID=
FRS_LTI_PLATFORM_PUBLIC_KEY_PEM=
FRS_REQUIRE_ALL_SPECIALISTS=true

# Provision real ONNX files through an explicitly licensed source. For every ONNX
# file at path NAME.onnx, supply a matching NAME.onnx.json contract/provenance file.
FRS_RETINAFACE_ONNX_PATH=/models/retinaface.onnx
FRS_ADAFACE_ONNX_PATH=/models/adaface.onnx
FRS_MOBILEFACENET_ONNX_PATH=/models/mobilefacenet.onnx
FRS_MINIFASNET_ONNX_PATH=/models/minifasnet.onnx
FRS_FIQA_ONNX_PATH=/models/fiqa.onnx
FRS_FIQA_MIN_QUALITY_SCORE=0.45

FRS_REQUIRE_LIVENESS=true
FRS_MINIMUM_IDENTIFICATION_FRAMES=3
FRS_MAXIMUM_IDENTIFICATION_FRAMES=8
FRS_TEMPORAL_MIN_VOTE_FRACTION=0.67
FRS_ATTENDANCE_COOLDOWN_SECONDS=60
FRS_SIMILARITY_THRESHOLD=0.50
FRS_MODEL_THRESHOLDS_JSON={"ArcFace":0.50,"AdaFace":0.50,"MobileFaceNet":0.50}
FRS_THRESHOLD_CALIBRATED=false
FRS_CALIBRATED_MODELS_CSV=
FRS_REQUIRED_LIVENESS_SCORE=0.90
FRS_ENROLLMENT_MIN_PROFILE_CONSISTENCY=0.45

FRS_MIN_FACE_SIZE_PX=80
FRS_MIN_LAPLACIAN_VARIANCE=25.0
FRS_MIN_MEAN_LUMINANCE=35.0
FRS_MAX_MEAN_LUMINANCE=220.0
FRS_MAX_CLIPPED_PIXEL_RATIO=0.40
FRS_AMBIGUITY_MARGIN=0.05
FRS_RECOGNITION_TOP_K=5
FRS_MAX_UPLOAD_BYTES=5242880
FRS_MAX_REQUEST_BYTES=41943040
FRS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
